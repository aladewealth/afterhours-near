# NEAR network + contract (defaults shown)
NEAR_NETWORK=testnet
NEAR_BOARD_CONTRACT=board.afterhours-near.testnet
NEAR_AGENT_ACCOUNT=agent.afterhours-near.testnet
NEAR_RESOLVER_ACCOUNT=resolver.afterhours-near.testnet
# Function-call access keys only (ed25519:...). Leave empty for a read-only site.
NEAR_AGENT_KEY=
NEAR_RESOLVER_KEY=
# Shared secret for POST /api/near/agent/run
AGENT_RUN_SECRET=
# Optional: NEAR AI Cloud key for LLM-written notes (https://cloud.near.ai)
NEAR_AI_API_KEY=
